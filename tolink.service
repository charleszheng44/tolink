[Unit]
Description=tolink - local URL shortcut service
After=network.target

[Service]
# Binds to 127.0.0.1:4080 by default (localhost only).
# To expose on a LAN/internet or bind to port 80, change -addr and ensure
# the machine is appropriately firewalled — the admin UI has no authentication.
ExecStart=/usr/local/bin/tolink -addr 127.0.0.1:4080 -data /var/lib/tolink/links.json
Restart=on-failure
DynamicUser=yes
StateDirectory=tolink
# CAP_NET_BIND_SERVICE is only needed when -addr uses a port < 1024 (e.g. :80).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=multi-user.target
